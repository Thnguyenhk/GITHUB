def recursive(n):
    if n == 0:
        return 1
    else:
        return n * recursive(n-1)
print(recursive(5))

def iterative(n):
    result = 1
    for i in range (1,n+1): result *= i
    return result
print(iterative(5))

#Test efficiency of both version
%timeit recursive(5)
%timeit iterative(5)